@model List<RaceDay.Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Explore Events";
}

<div class="container py-5">

    <div class="d-flex flex-wrap justify-content-between
                align-items-center mb-4">

        <div>
            <h1 class="fw-bold">Explore RaceDay Events</h1>
            <p class="text-muted">
                Find your next running, walking or cycling challenge.
            </p>
        </div>

        @if (ViewBag.Role == "Organiser")
        {
            <a asp-action="Create"
               class="btn btn-primary">
                + Create Event
            </a>
        }

    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0 rounded-4">

                        <div class="card-body p-4">

                            <h4 class="fw-bold">
                                @item.Name
                            </h4>

                            <p class="text-muted">
                                @item.Description
                            </p>

                            <hr />

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @item.Distance km
                            </p>

                            <a asp-action="Details"
                               asp-route-id="@item.EventID"
                               class="btn btn-outline-primary w-100">
                                View Event
                            </a>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>
