@model List<RaceDay.Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Explore Events";
}

<div class="container py-5">

    <div class="d-flex flex-wrap justify-content-between
                align-items-center mb-4">

        <div>
            <h1 class="fw-bold">Explore RaceDay Events</h1>
            <p class="text-muted">
                Find your next running, walking or cycling challenge.
            </p>
        </div>

        @if (ViewBag.Role == "Organiser")
        {
            <a asp-action="Create"
               class="btn btn-primary">
                + Create Event
            </a>
        }

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0 rounded-4">

                        @if (!string.IsNullOrEmpty(item.BannerImageUrl))
                        {
                            <img src="@item.BannerImageUrl"
                                 class="card-img-top"
                                 alt="@item.Name banner"
                                 style="height: 200px; object-fit: cover;" />
                        }

                        <div class="card-body p-4">

                            <h4 class="fw-bold">
                                @item.Name
                            </h4>

                            <p class="text-muted">
                                @item.Description
                            </p>

                            <hr />

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @item.Distance km
                            </p>

                            <a asp-action="Details"
                               asp-route-id="@item.EventID"
                               class="btn btn-outline-primary w-100 mb-2">
                                View Event
                            </a>

                            @if (ViewBag.Role == "Organiser")
                            {
                                <div class="d-flex gap-2 mb-3">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.EventID"
                                       class="btn btn-primary btn-sm flex-fill">
                                        Edit Event
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.EventID"
                                       class="btn btn-danger btn-sm flex-fill">
                                        Delete Event
                                    </a>

                                </div>

                                <hr />

                                <h6 class="fw-bold">
                                    Event Banner
                                </h6>

                                <form asp-controller="Organiser"
                                      asp-action="UploadEventBanner"
                                      method="post"
                                      enctype="multipart/form-data">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="eventId"
                                           value="@item.EventID" />

                                    <input type="file"
                                           name="file"
                                           class="form-control mb-2"
                                           accept=".jpg,.jpeg,.png,.gif,.webp"
                                           required />

                                    <button type="submit"
                                            class="btn btn-outline-success btn-sm w-100">
                                        Upload Banner
                                    </button>

                                </form>
                            }

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>
