@model RaceDay.Web.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">

    <h2 class="mb-3">Event Details</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <h3>@Model.Name</h3>

            <p class="text-muted">
                @Model.Description
            </p>

            <hr />

            <p>
                <strong>Event Date:</strong>
                @Model.EventDate.ToString("dd MMMM yyyy")
            </p>

            <p>
                <strong>Location:</strong>
                @Model.Location
            </p>

            <p>
                <strong>Distance:</strong>
                @Model.Distance km
            </p>

            <h4 class="mt-4">Available Categories</h4>

            @if (Model.Categories == null ||
                 !Model.Categories.Any())
            {
                <div class="alert alert-info">
                    No categories are currently available.
                </div>
            }
            else
            {
                @foreach (var category in Model.Categories)
                {
                    <div class="card mb-3">
                        <div class="card-body">

                            <h5>@category.CategoryName</h5>

                            <p>
                                @category.Description
                            </p>

                            <form asp-controller="Participant"
                                  asp-action="Enrol"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="eventId"
                                       value="@Model.EventID" />

                                <input type="hidden"
                                       name="categoryId"
                                       value="@category.CategoryID" />

                                <button type="submit"
                                        class="btn btn-primary">
                                    Enrol in this Category
                                </button>

                            </form>

                        </div>
                    </div>
                }
            }

            <a asp-action="BrowseEvents"
               class="btn btn-secondary mt-3">
                Back to Events
            </a>

        </div>
    </div>
</div>
