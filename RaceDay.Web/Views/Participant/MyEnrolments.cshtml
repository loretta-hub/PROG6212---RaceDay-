@model List<RaceDay.Web.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2>My Enrolments</h2>
    <p class="text-muted">
        View the events you have registered for.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Enrolment ID</th>
                        <th>Event ID</th>
                        <th>Category ID</th>
                        <th>Enrolment Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.EnrolmentID</td>
                            <td>@item.EventID</td>
                            <td>@item.CategoryID</td>
                            <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <form asp-action="CancelEnrolment"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to cancel this enrolment?');">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.EnrolmentID" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Cancel
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
