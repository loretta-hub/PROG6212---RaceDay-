@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container py-5">

    <div class="mb-5">
        <h1 class="fw-bold">Participant Dashboard</h1>

        <p class="text-muted">
            Welcome, @ViewBag.FirstName!
            Ready for your next challenge?
        </p>
    </div>

    <div class="row g-4">

        <!-- Browse Events -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold"> Browse Events</h4>

                    <p class="text-muted">
                        Explore upcoming running, walking
                        and cycling events.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary">
                        Explore Events
                    </a>
                </div>
            </div>
        </div>

        <!-- My Enrolments -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold"> My Enrolments</h4>

                    <p class="text-muted">
                        View the events you have entered
                        and check your enrolment details.
                    </p>

                    <a href="#"
                       class="btn btn-outline-primary">
                        View Enrolments
                    </a>
                </div>
            </div>
        </div>

        <!-- My Results -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold"> My Results</h4>

                    <p class="text-muted">
                        View your published event results
                        and achievements.
                    </p>

                    <a href="#"
                       class="btn btn-outline-primary">
                        View Results
                    </a>
                </div>
            </div>
        </div>

        <!-- My Profile -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold"> My Profile</h4>

                    <p class="text-muted">
                        View and update your personal
                        account information.
                    </p>

                    <a href="#"
                       class="btn btn-outline-primary">
                        Manage Profile
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
