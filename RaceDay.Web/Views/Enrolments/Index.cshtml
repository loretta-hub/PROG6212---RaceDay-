@model List<RaceDay.Web.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "Manage Enrolments";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Enrolments</h2>
            <p class="text-muted">
                View participants enrolled in your events.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No enrolments are currently available for your events.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <h5 class="mb-3">Enrolment Records</h5>

                <table class="table table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Enrolment ID</th>
                            <th>Participant ID</th>
                            <th>Event ID</th>
                            <th>Category ID</th>
                            <th>Enrolment Date</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.EnrolmentID</td>
                                <td>@item.ParticipantID</td>
                                <td>@item.EventID</td>
                                <td>@item.CategoryID</td>
                                <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    }

</div>
