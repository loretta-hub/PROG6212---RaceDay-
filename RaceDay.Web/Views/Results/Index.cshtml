@model List<RaceDay.Web.Models.ResultViewModel>

@{
    ViewData["Title"] = "Manage Results";
}

<div class="container mt-4">

    <h2>Manage Results</h2>
    <p class="text-muted">
        View race results recorded for your events.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <p>
        <a asp-controller="Results"
           asp-action="Create"
           class="btn btn-primary">
            + Capture New Result
        </a>
    </p>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No results have been recorded yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>Result ID</th>
                        <th>Enrolment ID</th>
                        <th>Finish Time</th>
                        <th>Finishing Position</th>
                        <th>Recorded At</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.ResultID</td>
                            <td>@result.EnrollmentID</td>
                            <td>@result.FinishTime</td>
                            <td>@result.FinishingPosition</td>
                            <td>@result.RecordedAt.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>
