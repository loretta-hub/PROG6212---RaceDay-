@{
    ViewData["Title"] = "Capture Results";
}

<div class="container mt-4">

    <h2>Capture Participant Results</h2>

    <p class="text-muted">
        Enter the finishing time and position for an enrolled participant.
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <div class="card shadow-sm mt-4">
        <div class="card-body">

            <form asp-controller="Results"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Enrolment</label>

                    <select name="enrolmentId"
                            class="form-select"
                            asp-items="ViewBag.Enrolments"
                            required>
                        <option value="">Select an enrolment</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Finish Time</label>

                    <input type="time"
                           name="finishTime"
                           step="1"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Finishing Position</label>

                    <input type="number"
                           name="finishingPosition"
                           min="1"
                           class="form-control"
                           placeholder="e.g. 47"
                           required />
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Result
                </button>

                <a asp-controller="Results"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>
